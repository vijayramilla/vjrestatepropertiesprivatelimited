# ─────────────────────────────────────────────────────────────────────────────
# VJR Estate — environment variables
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (AUTH STAYS HERE — do not change, do not remove) ────────────────
# Google Sign-In and session handling continue to use Firebase Authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Supabase — site data (properties, requirements, leads, users, settings,
#    jobs, auctions) ─────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://eimvaxrmiizdlgonhiov.supabase.co
VITE_SUPABASE_ANON_KEY=
# Feature flag. Keep at 0 during migration. Set to 1 ONLY after the migration
# scripts have copied Firestore + Storage into Supabase and you have verified.
VITE_USE_SUPABASE_DATA=0

# Supabase — CRM data (already in production; leave as-is)
# VITE_SUPABASE_MANAGEMENT_KEY=

# ── Serverless proxies ───────────────────────────────────────────────────────
# Base URL of the Vercel API (also used for /api/data-proxy and /api/crm-proxy).
# Empty = same origin in production; use the Vercel dev proxy in local dev.
VITE_API_URL=

# ── Other existing integrations (unchanged) ─────────────────────────────────
# Browser key for Google Maps JS, Places, and Geocoding APIs. Restrict it by
# HTTP referrer in Google Cloud Console (vjrestate.com + localhost). The code
# falls back to the current production key if this is left empty.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyBSalDHPAJQmCsZHXJdGx_mvoN9jRz1G4A
VITE_OPENROUTER_API_KEY=
VITE_GROQ_API_KEY=
VITE_SITE_URL=https://vjrestate.com
VITE_LEAD_API_KEY=
VITE_OWNER_API_URL=
VITE_STRAPI_ADMIN_EMAIL=


# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY (Vercel project settings → Environment Variables).
# Never put these in .env or anywhere the browser can read them.
# ─────────────────────────────────────────────────────────────────────────────
# Supabase service-role key for /api/data-proxy and /api/crm-proxy.
VITE_SUPABASE_REQ_URL=https://eimvaxrmiizdlgonhiov.supabase.co
VITE_SUPABASE_REQ_SERVICE_KEY=

# REQUIRED in production. The CRM project's service-role key (same project as
# the publishable key used by the CRM proxies). Every CRM table has RLS locked
# to the service role only (supabase/migrations/20260820000000_crm_rls_lockdown.sql),
# so WITHOUT this key set in Vercel the whole CRM (employees, clients, logins,
# uploads) stops working. Same value as SUPABASE_SERVICE_ROLE_KEY below.
VITE_SUPABASE_CLI_SERVICE_KEY=

# Single Supabase project — all data, CRM, storage, employees.
VITE_SUPABASE_CLI_URL=https://eimvaxrmiizdlgonhiov.supabase.co
VITE_SUPABASE_CLI_SERVICE_KEY=
# Publishable (anon) key — used by the browser for the
# Storage dashboard's realtime fast-path.
VITE_SUPABASE_CLI_ANON_KEY=

# Storage quota shown in the admin Storage dashboard (bytes). Defaults to the
# 1 GB free-plan limit — raise it if you upgrade to Pro (100 GB = 107374182400).
# VITE_SUPABASE_STORAGE_QUOTA_BYTES=1073741824

# Firebase UID of the primary super admin (defense-in-depth on the proxy).
VITE_ADMIN_UID=

# ─────────────────────────────────────────────────────────────────────────────
# MIGRATION SCRIPTS ONLY (run once locally — never in the browser, never in
# Vercel). node scripts/migrate-firestore.mjs and scripts/migrate-storage.mjs.
# ─────────────────────────────────────────────────────────────────────────────
# Path to (or inline JSON of) the Firebase service-account key.
FIREBASE_SERVICE_ACCOUNT=
# Or rely on standard Application Default Credentials:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Default Firebase storage bucket, e.g. vjr-estate.appspot.com.
FIREBASE_STORAGE_BUCKET=

# Service-role key used by the migration scripts (same key as
# VITE_SUPABASE_REQ_SERVICE_KEY above).
SUPABASE_SERVICE_ROLE_KEY=
