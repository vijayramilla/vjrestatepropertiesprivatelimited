# Copy to Vercel → Project → Settings → Environment Variables (or local .env)
# Never commit .env — it is gitignored.

# Firebase (Firebase Console → Project settings → Your apps → Web app config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Maps Browser Key (Google Cloud Console → APIs & Services → Credentials)
# This key is PUBLIC (visible to browser) — MUST be restricted by HTTP referrer
# Restrict to HTTP referrers: https://www.vjrestate.com, https://vjrestate.com, http://localhost:5173*
# Enable APIs: Maps JavaScript API, Places API
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Google Maps Server Key (Google Cloud Console → APIs & Services → Credentials)
# This key is PRIVATE — stored server-side only, NEVER in VITE_ env vars
# Restrict to IP: your Vercel function egress IP (or unrestricted in development)
# Enable APIs: Geocoding API, Places API (New)
GOOGLE_MAPS_SERVER_KEY=

# Public site URL for share links
VITE_SITE_URL=https://vjrestate.com

# Admin Firebase UID and email (override defaults from src/lib/adminAuth.ts)
VITE_ADMIN_UID=
VITE_ADMIN_EMAIL=

# Shared secret for the Google Forms -> leads webhook (api/google-form-webhook.ts)
# Set this in Vercel to avoid committing the default value.
VJR_LEAD_WEBHOOK_KEY=

# CRM/leads Supabase project (Supabase Dashboard → Project Settings → API)
# This is the SERVICE ROLE key — PRIVATE, server-side only. MUST be set in Vercel
# (Production, Preview and Development) or every CRM proxy action against the
# leads/admin tables (admin_users, leads, agents, follow_ups, ...) fails silently.
VITE_SUPABASE_REQ_URL=
VITE_SUPABASE_REQ_SERVICE_KEY=

# CLI Supabase project (employees + CRM clients) — anon key is fine, RLS is open
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_CLI_SERVICE_KEY=

# Frontend API base (Vercel functions live under /api)
VITE_API_URL=/api
