# Hashed build assets are cache-immutable (keeps old hashes from being served as HTML on back/refresh)
/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable

# Never cache the app shell (served at /, /legal, and all client-side routes)
/*
  Cache-Control: no-store